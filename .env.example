# CampusHub Environment Configuration Template

# Frontend EmailJS Configuration (for Welcome Emails upon Registration)
# 1. Sign up at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) -> VITE_EMAILJS_SERVICE_ID
# 3. Create a template -> VITE_EMAILJS_TEMPLATE_ID
# 4. Account -> API Keys -> Public Key -> VITE_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Backend Configuration (Flask / Python)
# Required in backend/.env
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SECRET_KEY=your_secret_key_here
# DATABASE_URL=sqlite:///campushub.db
